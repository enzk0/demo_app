  "html": "<h1 style=\"text-align: center;\">Athlete</h1>\n\n<p><span style=\"font-weight: bold;\">First Name: </span> {{doc.first_name}}</p>\n<p><span style=\"font-weight: bold;\">Middle Name: </span> {{doc.middle_name}}</p>\n<p><span style=\"font-weight: bold;\">Last Name: </span> {{doc.last_name}}</p>\n<p><span style=\"font-weight: bold;\">Age: </span> {{doc.age}}</p>\n<p><span style=\"font-weight: bold;\">Birthday: </span> {{doc.birthday}}</p>\n<p><span style=\"font-weight: bold;\">Sport: </span> {{doc.sports}}</p>\n<p><span style=\"font-weight: bold;\">Fullname: </span> {{doc.full_name}}</p>\n\n<h3 style=\"color: white;\">Games Played</h3>\n<table class=\"table table-bordered\" style=\"width: 100%; \">\n    <tr>\n        <th>Game</th>\n        <th>Date</th>\n        <th>Location</th>\n        <th>Score</th>\n        <th>Opponent</th>\n    </tr>\n    {% for row in doc.athlete_games %}\n    <tr>\n        <td>{{ row.game}}</td>\n        <td>{{ row.date }}</td>\n        <td>{{ row.location }}</td>\n        <td>{{ row.score }}</td>\n        <td>{{ row.opponent }}</td>\n    </tr>\n    {% endfor %}\n</table>\n\n<h3 style=\"color: white;\">Awards Won</h3>\n<table class=\"table table-bordered\" style=\"width: 100%; \">\n    <tr>\n        <th>Award</th>\n        <th>Year</th>\n        <th>Organization</th>\n        <th>Remarks</th>\n    </tr>\n    {% for row in doc.athlete_awards %}\n    <tr>\n        <td>{{ row.award}}</td>\n        <td>{{ row.year }}</td>\n        <td>{{ row.organization }}</td>\n        <td>{{ row.remarks }}</td>\n    </tr>\n    {% endfor %}\n</table>",
