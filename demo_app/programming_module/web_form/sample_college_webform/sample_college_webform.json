 "client_script": "frappe.web_form.after_load = function () {\r\n    console.log('web_form.after_load fired');\r\n\r\n    frappe.web_form.on(\"birthdate\", (field, value) => {\r\n        if (value) {\r\n            const birthdate = new Date(value);\r\n            const today = new Date();\r\n            const age = Math.floor(\r\n                (today - birthdate) / (365.25 * 24 * 60 * 60 * 1000)\r\n            );\r\n            frappe.web_form.set_value(\"age\", age);\r\n        }\r\n    });\r\n    \r\n    set_full_name();\r\n\r\n    frappe.web_form.on(\"pangalan\", () => set_full_name());\r\n    frappe.web_form.on(\"pangalang_panggitna\", () => set_full_name());\r\n    frappe.web_form.on(\"apilyedo\", () => set_full_name());\r\n\r\n    function set_full_name() {\r\n        let full_name = \"\";\r\n\r\n        const pangalan = frappe.web_form.get_value(\"pangalan\");\r\n        const pangalang_panggitna = frappe.web_form.get_value(\"pangalang_panggitna\");\r\n        const apilyedo = frappe.web_form.get_value(\"apilyedo\");\r\n\r\n        if (pangalan) full_name += pangalan + \" \";\r\n        if (pangalang_panggitna) full_name += pangalang_panggitna + \" \";\r\n        if (apilyedo) full_name += apilyedo;\r\n\r\n        full_name = full_name.trim();\r\n\r\n        if (full_name) {\r\n            frappe.web_form.set_value(\"kompletong_pangalan\", full_name);\r\n\r\n            if (frappe.web_form.doc.__islocal) {\r\n                frappe.web_form.doc.name = full_name;\r\n            }\r\n        }\r\n    }\r\n};\r\n",
